# Set separate random secrets. Never commit real credentials.
NEXUS_ADMIN_KEY=
NEXUS_API_KEY=
NEXUS_MODEL_BACKEND=gguf
# Omit MODEL_PATH to download the pinned model automatically.
# MODEL_PATH=checkpoints/complete-model.gguf
NEXUS_CORS_ORIGINS=
NEXUS_ENABLE_CRAWLER=0
NEXUS_RATE_LIMIT=60

# Optional managed inference through a FreeLLM-compatible gateway.
# Set the base URL to the gateway's OpenAI-compatible /v1 endpoint.
FREELLM_BASE_URL=
FREELLM_API_KEY=
FREELLM_MAX_MODEL_ATTEMPTS=4
# Store this SQLite file on a persistent disk to retain circuit state.
NEXUS_PROVIDER_HEALTH_DB=vonk_provider_health.sqlite3
